{
  "name": "quickfile-rest-mcp",
  "version": "0.1.0",
  "description": "A full MCP server for QuickFile's modern REST API and personal bearer tokens.",
  "type": "module",
  "bin": {
    "quickfile-rest-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "openapi:sync": "tsx scripts/sync-openapi.ts",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qa": "npm run lint && npm run typecheck && npm test && npm run build && npm run openapi:check"
  },
  "keywords": [
    "quickfile",
    "mcp",
    "model-context-protocol",
    "accounting",
    "rest-api",
    "ai"
  ],
  "author": "Chris Leah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjohnleah/quickfile-rest-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chrisjohnleah/quickfile-rest-mcp/issues"
  },
  "homepage": "https://github.com/chrisjohnleah/quickfile-rest-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.11"
    }
  }
}
